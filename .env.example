PROMPTCAD_ENV=development
PROMPTCAD_HOST=0.0.0.0
PROMPTCAD_PORT=8000
# Docker Compose defaults to loopback. Set a non-loopback bind only with a strong API token.
PROMPTCAD_BIND_ADDRESS=127.0.0.1
PROMPTCAD_DATA_DIR=generated

# rule: fully local parser; llm: configured provider; auto: use LLM when configured, else rule
PROMPTCAD_PLANNER_MODE=auto
PROMPTCAD_RENDER_BACKEND=auto
PROMPTCAD_ALLOW_SOURCE_FALLBACK=true
PROMPTCAD_RENDER_TIMEOUT_SECONDS=120
PROMPTCAD_MAX_PROMPT_CHARS=4000
PROMPTCAD_MAX_IMAGE_BYTES=10000000
PROMPTCAD_MAX_IMAGE_PIXELS=12000000
PROMPTCAD_MAX_IMAGE_DIMENSION=4096
PROMPTCAD_IMAGE_ANALYSIS_TIMEOUT_SECONDS=20
PROMPTCAD_IMAGE_ANALYSIS_CONCURRENCY=2
PROMPTCAD_MAX_DXF_BYTES=5000000
PROMPTCAD_MAX_DXF_ENTITIES=2000
PROMPTCAD_MAX_DXF_SEGMENTS=256
PROMPTCAD_MAX_DXF_HOLES=64
PROMPTCAD_DXF_ANALYSIS_TIMEOUT_SECONDS=20
PROMPTCAD_DXF_ANALYSIS_CONCURRENCY=2

# Optional protection. When set, send Authorization: Bearer <token> or X-API-Key.
PROMPTCAD_API_TOKEN=
PROMPTCAD_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# OpenAI-compatible Chat Completions endpoint, including llama.cpp / OpenRouter / xAI / DeepSeek.
PROMPTCAD_LLM_BASE_URL=https://api.openai.com/v1
PROMPTCAD_LLM_API_KEY=
PROMPTCAD_LLM_MODEL=gpt-5.6
PROMPTCAD_LLM_STRUCTURED_MODE=json_schema
PROMPTCAD_LLM_TIMEOUT_SECONDS=90
PROMPTCAD_LLM_MAX_RETRIES=1
PROMPTCAD_LLM_FALLBACK_TO_RULE=true
